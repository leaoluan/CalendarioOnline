# ==============================================================================
# Chronos Calendar - Configurações de Ambiente
# ==============================================================================

# --- SUPABASE (Banco de Dados e Autenticação) ---
# Obtenha em: https://supabase.com/dashboard -> Seu Projeto -> Project Settings -> API
# VITE_SUPABASE_URL: Project URL (deve terminar em .supabase.co)
# Se desejar nuvem Supabase, preencha abaixo. Deixe vazio para rodar 100% no navegador:
# VITE_SUPABASE_URL=https://seu-projeto-id.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1Ni...
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- GOOGLE GEMINI AI (Opcional) ---
# Utilizado para briefing matinal executivo e análise de produtividade
# GEMINI_API_KEY=sua_chave_do_google_ai_studio_aqui

# --- PORTA DO SERVIDOR (Opcional - padrão: 3000) ---
PORT=3000
